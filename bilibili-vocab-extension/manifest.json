{
  "manifest_version": 3,
  "name": "Bilibili Subtitle Vocabulary",
  "version": "0.1.3",
  "description": "在 Bilibili / YouTube 字幕里低打扰插入英文词汇，把刷视频变成碎片时间英语输入",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://aisubtitle.hdslb.com/*",
    "https://www.youtube.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "config.js",
        "runtimeMessaging.js",
        "sharedSettings.js",
        "experienceMetrics.js",
        "adaptiveTuning.js",
        "learningState.js",
        "utils.js",
        "vocabulary-pure.js",
        "vocabulary.js",
        "translator.js",
        "renderer.js",
        "subtitleParser.js",
        "scripts/danmaku.js",
        "scripts/scheduler.js",
        "tooltip.js",
        "subtitleNavigation.js",
        "overlaySubtitleNavigationBridge.js",
        "subtitleNavigationController.js",
        "runtimeSettingsSync.js",
        "webTextReplacement.js",
        "overlayLoader.js",
        "contentScript/constants.js",
        "contentScript/translation-pipeline.js",
        "contentScript/dom-observer.js",
        "contentScript/danmaku-engine.js",
        "contentScript/subtitle-navigation-bridge.js",
        "contentScript/index.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dist/options.html",
  "action": {
    "default_title": "Bilibili Subtitle Vocabulary",
    "default_popup": "dist/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data/*.json",
        "dist/overlay.js"
      ],
      "matches": [
        "https://www.bilibili.com/*",
        "https://www.youtube.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "开关字幕替换功能"
    },
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "开关悬浮控制面板"
    },
    "increase-ratio": {
      "suggested_key": {
        "default": "Ctrl+Shift+Up",
        "mac": "Command+Shift+Up"
      },
      "description": "提高词汇替换比例"
    },
    "decrease-ratio": {
      "suggested_key": {
        "default": "Ctrl+Shift+Down",
        "mac": "Command+Shift+Down"
      },
      "description": "降低词汇替换比例"
    }
  }
}
